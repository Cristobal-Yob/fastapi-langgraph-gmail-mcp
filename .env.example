# Generate each secret yourself. Never commit a populated .env.
AGENT_API_TOKEN=
PUBLIC_ORIGIN=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=
MODELO=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.5-flash
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
PORT=8000
# Existing external PostgreSQL only. Provisioning/cost needs separate approval.
DATABASE_URL=
STATE_NAMESPACE=
# Fernet.generate_key(), kept stable across restarts.
STATE_ENCRYPTION_KEY=
EMAIL_ENABLE_REAL_SEND=false
GMAIL_SENDER=
GMAIL_PROJECT_ID=
GMAIL_CLIENT_ID=
# Protected Config Var JSON: type, project_id, account_email, account_sub, client_id,
# client_secret, refresh_token, token_uri, scopes. See HEROKU.md.
GMAIL_OAUTH_JSON=
MCP_BOUNDARY_KEY=
